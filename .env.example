# VentureBot Environment — TEMPLATE (copy to .env and fill in real values)
# NEVER commit .env. This file holds the shape only.

# Google AI Studio key — ADK's Gemini models read GOOGLE_API_KEY (not GEMINI_API_KEY)
GOOGLE_API_KEY=

# Google OAuth (dashboard login) — see README "Google OAuth setup" for the full guide:
#   1. Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
#   2. Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback
#   3. Copy the client secret into GOOGLE_CLIENT_SECRET below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL (used to build the OAuth redirect URI; trust nginx X-Forwarded-*)
VENTUREBOT_PUBLIC_BASE_URL=
# Set true behind HTTPS — cookies get the Secure flag and HSTS is emitted
VENTUREBOT_COOKIE_SECURE=false
# Comma-separated allowlist of emails permitted to log in (optional extra gate)
VENTUREBOT_ALLOWED_EMAILS=
# true = freeze new registrations; existing users keep logging in
#VENTUREBOT_SIGNUP_CLOSED=false
# 1 = prototype/no-login (app boots straight in); 0 = Google login enforced
VENTUREBOT_NO_AUTH=1

# Budget — configurable; human can raise at runtime via the UI (default $20)
VENTUREBOT_DAILY_BUDGET_LIMIT=20.00

# Models (Phase 1 = Gemini ADK)
VENTUREBOT_MODEL_RESEARCHER=gemini-3.7-flash
VENTUREBOT_MODEL_ADVOCATE=gemini-3.7-flash
VENTUREBOT_MODEL_CRITIC=gemini-3.1-pro-preview
VENTUREBOT_MODEL_JUDGE=gemini-3.1-pro-preview
VENTUREBOT_MODEL_PRD_WRITER=gemini-3.1-pro-preview
VENTUREBOT_MODEL_AUDITOR=gemini-3.1-pro-preview
# Creative Ideator — divergent head; runs hot by default
VENTUREBOT_MODEL_CREATIVE=gemini-3.7-flash
VENTUREBOT_CREATIVE_TEMPERATURE=1.0

# Orchestrator loop budget (autonomous agentic loop)
VENTUREBOT_ORCHESTRATOR_MAX_TURNS=10
VENTUREBOT_ORCHESTRATOR_MAX_TOOL_CALLS=50
VENTUREBOT_ORCHESTRATOR_STALL_TURNS=3
VENTUREBOT_MODEL_ORCHESTRATOR=gemini-3.1-pro-preview

# OpenRouter (Phase 2) — optional; falls back to ~/.pi/agent/auth.json if unset
OPENROUTER_API_KEY=

# Loop budget
VENTUREBOT_MAX_ITERATIONS=5
VENTUREBOT_LLM_TIMEOUT=120
VENTUREBOT_MAX_TOKENS=4096
VENTUREBOT_RUN_DEADLINE=900
