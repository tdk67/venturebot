# VentureBot env template (never commit your actual .env file)
# Non-secret settings live in config.json (committed to git).
#
# On GCP Cloud Run: set these as env vars or via Secret Manager.
# Locally: copy this file to .env and fill in real values.

# Secrets
GOOGLE_API_KEY=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=

# Deployment overrides (not secrets, but env-specific)
# Set these on Cloud Run or locally in .env. Defaults are in config.json.
GOOGLE_CLIENT_ID=
VENTUREBOT_PUBLIC_BASE_URL=
VENTUREBOT_NO_AUTH=true
VENTUREBOT_COOKIE_SECURE=false

# Optional: restrict logins to specific emails (comma-separated)
VENTUREBOT_ALLOWED_EMAILS=
VENTUREBOT_SIGNUP_CLOSED=false